#!/bin/bash
SELF=$(readlink -f "$0")
HERE="${SELF%/*}"

export PATH="${HERE}/usr/bin:${PATH}"
export LD_LIBRARY_PATH="${HERE}/usr/lib:${LD_LIBRARY_PATH}"
export PYTHONPATH="${HERE}/usr/lib/python3/dist-packages:${PYTHONPATH}"
export XDG_RUNTIME_DIR="/run/user/$(id -u)"
export DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u)/bus"

# Find the system Python3
PYTHON3=$(which python3 2>/dev/null || echo "python3")

# Show usage if no args or help
if [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
    echo "SpeakEasy - Offline Voice Tools"
    echo ""
    echo "Usage:"
    echo "  ./SpeakEasy.AppImage [OPTION]"
    echo ""
    echo "Options:"
    echo "  (no args)        Start Dictation Engine"
    echo "  --launcher       Start Program Launcher (Super+A)"
    echo "  --settings       Open GUI Settings Manager"
    echo "  --help, -h       Show this help message"
    echo ""
    echo "Examples:"
    echo "  ./SpeakEasy.AppImage              # Start dictation"
    echo "  ./SpeakEasy.AppImage --launcher   # Listen for app commands"
    echo "  ./SpeakEasy.AppImage --settings   # Configure commands"
    exit 0
fi

# Determine mode from first argument
MODE="${1:-dictation}"

case "$MODE" in
    launcher|--launcher|-l)
        exec "$PYTHON3" "${HERE}/Program_Launcher/voice_assistant.py"
        ;;
    settings|--settings|-s)
        exec "$PYTHON3" "${HERE}/settings_gui.py"
        ;;
    dictation|--dictation|-d|*)
        exec "$PYTHON3" "${HERE}/voice_to_text_dictation.py"
        ;;
esac
